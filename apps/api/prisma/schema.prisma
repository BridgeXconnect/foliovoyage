// Prisma schema for the Folio Voyage API.
//
// ST-5 / BRI-100: deliberately minimal — just enough to prove the first
// vertical slice (browser → web → API → Postgres) against one seeded row.
// Real domain modelling is M1's job; resist growing this beyond what the
// destination page actually renders (a title, a hero image, and a short list).
//
// BRI-164 / ST-11: the first cross-model links land here — `Tour.experienceId`
// (a Tour is linked to at most one Experience) and the Experience lifecycle
// `status` (auto-created Experiences start `draft`, promoted to `published` by
// an explicit CLI standing in for Admin review, M7). Geo is stored as plain
// `Float` lat/lng throughout (City centroid, Experience point), *not* PostGIS —
// a deliberate divergence from docs/02's `geography(Point,4326)` DDL, chosen to
// match the existing `Tour`/`ProviderLocation` Float columns and stay
// Prisma-native (no `postgisExtensions` preview feature, no raw-SQL geometry).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A destination city, addressed in the URL as /destinations/:country/:city.
model City {
  id            String                   @id @default(cuid())
  /// URL slug for the city, e.g. "paris".
  slug          String
  /// URL slug for the country, e.g. "france".
  countrySlug   String
  /// Display name, e.g. "Paris".
  name          String
  /// Display country, e.g. "France".
  country       String
  /// Absolute hero image URL.
  heroImageUrl  String
  /// Hero image alt text (accessibility + SEO).
  heroImageAlt  String
  /// Viator destination ref this curated city maps to (e.g. "343" for Bangkok),
  /// or null for a hand-authored city with no imported inventory. This is the
  /// key the import linker matches a Tour's `destinationRefs` against to decide
  /// which City an imported Experience belongs to (BRI-164 exact-ref linkage).
  viatorDestRef String?                  @unique
  /// City centroid latitude (WGS-84), from Viator's `/destinations` `center`.
  /// Used as the geo fallback when an imported Tour has no resolved coordinates
  /// (BRI-163): the auto-created Experience's required point falls back to this.
  centroidLat   Float?
  /// City centroid longitude (WGS-84); see {@link centroidLat}.
  centroidLng   Float?
  experiences   Experience[]
  /// Full-text search vector over `name` + `country` (ST-13 / BRI-125, Phase-A
  /// Postgres FTS — docs/02 §8). A real Postgres `GENERATED ALWAYS AS ... STORED`
  /// column: both source columns live on this same row, so — unlike
  /// {@link Experience.searchVector} — no trigger is needed to keep it in sync.
  /// `Unsupported` because Prisma has no native tsvector type; the generated
  /// expression and GIN index are hand-written in the migration SQL, and the
  /// column is only ever read via raw SQL, never written through Prisma Client.
  /// `@default(dbgenerated(...))` here is a representation fix, not a real
  /// default: Postgres stores a `GENERATED ALWAYS AS ... STORED` expression in
  /// the same catalog (`pg_attrdef`) as an ordinary column default, and without
  /// this annotation Prisma's migrate diff reads that catalog entry as "the
  /// schema declares no default, drop the DB's one" and emits an invalid
  /// `ALTER COLUMN ... DROP DEFAULT` (Postgres wants `DROP EXPRESSION` for a
  /// generated column instead). Declaring the exact expression text here makes
  /// Prisma see schema and DB as already in sync, so it proposes no statement
  /// for this column at all — matches the generation expression in
  /// `20260818184829_add_search_vectors/migration.sql` verbatim.
  searchVector  Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(country, ''::text)), 'B'::\"char\"))"))

  /// A country+city slug pair uniquely identifies a destination.
  @@unique([countrySlug, slug])
  @@index([searchVector], type: Gin)
}

/// A single curated experience shown in the destination's list.
///
/// BRI-164 / ST-11: an Experience is Atlas's curated concept. The import linker
/// auto-creates one per imported `Tour` that maps to a curated city, starting in
/// `status: "draft"` — never `published` (there is no review step yet; an
/// explicit CLI, standing in for Admin review in M7, promotes it). Only
/// `published` Experiences are visible on the public site.
model Experience {
  id           String @id @default(cuid())
  title        String
  description  String
  /// Lifecycle state. Minimal for now — `draft` (auto-created / not yet
  /// reviewed) or `published` (visible on the site). Deliberately a plain
  /// String, not an enum: docs/02 §1.2's full lifecycle
  /// (draft→enriched→published→featured?→archived) is aspirational, and this
  /// story only needs the two states, addable-to without a schema change.
  status       String @default("draft")
  /// Experience point latitude (WGS-84). NOT NULL by design: an Experience
  /// always has a location. For an auto-created one it is the linked Tour's
  /// resolved latitude, falling back to the tour's Bali sub-region centre
  /// (BRI-218), then the parent City's centroid when the Tour has none (BRI-163).
  /// The linker fails loudly if none is available rather than writing a null.
  /// Set only at creation; `backfill-experience-coordinates.cli.ts` re-derives it.
  latitude     Float
  /// Experience point longitude (WGS-84); see {@link latitude}.
  longitude    Float
  /// Atlas-owned editorial rating (0–5), distinct from the provider's
  /// `Tour.ratingAvg`. Null until an editor sets it — ingest never writes it
  /// (docs/02 §1.3 ownership boundary), so auto-created Experiences carry null.
  editorRating Float?
  /// Sort order within the city's list.
  position     Int    @default(0)
  cityId       String
  city         City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  /// Tours linked to this Experience. The FK lives on {@link Tour.experienceId};
  /// the import linker keeps this 1:1 in practice (one auto-created Experience
  /// per source Tour), while the schema leaves room for docs/02's future
  /// many-Tours-per-Experience model.
  tours        Tour[]

  /// Provenance of an auto-created Experience: the provider + product id of the
  /// Tour it was created from. This is the idempotency key that makes
  /// auto-creation safe to re-run and race-safe under concurrent imports — a
  /// second run for the same Tour collides here instead of creating a duplicate.
  /// Null for hand-seeded (non-imported) Experiences.
  sourceProvider       String?
  sourceProviderTourId String?

  /// Full-text search vector (ST-13 / BRI-125, Phase-A Postgres FTS — docs/02
  /// §8), weighted title (A) > description (B) > parent city name/country (C)
  /// so a title match ranks above an incidental destination-name match. Kept in
  /// sync by a trigger, **not** a Postgres `GENERATED` column: a generated
  /// column can only reference columns on its own row, and this vector needs
  /// the linked `City`'s name/country too (see the migration SQL). `Unsupported`
  /// because Prisma has no native tsvector type; read/written only via raw SQL.
  searchVector Unsupported("tsvector")?

  @@unique([sourceProvider, sourceProviderTourId])
  @@index([cityId])
  /// The public read path filters published rows for a city.
  @@index([cityId, status])
  @@index([searchVector], type: Gin)
}

/// A published tour in the live catalogue (ST-9 / BRI-106).
///
/// This is where validated, location-resolved rows land: the ingest pipeline
/// upserts each run's `TourDTO` here, keyed on the immutable
/// `(provider, providerTourId)` pair. Re-running an import is therefore
/// idempotent — a row already present is updated in place, never duplicated.
///
/// Deletion is **soft**: a tour that disappears from a later run has `deletedAt`
/// set to the run time rather than being removed, so history is preserved and a
/// bad upstream response can be undone. All read paths MUST filter
/// `deletedAt: null`; a soft-deleted row is invisible to the public site. A
/// reappearing tour is revived (its `deletedAt` cleared) on the next upsert.
///
/// Columns mirror the provider-owned + provenance slice of `TourDTO`
/// (normalizer, ST-7). Atlas-owned editorial fields (editor rating, curated
/// tags, slug, curation status) are intentionally absent — ingest never writes
/// them (docs/02 §1.3 ownership boundary).
model Tour {
  id                     String      @id @default(cuid())
  /// Source OTA, from the DTO's `provider`. Always "viator" today.
  provider               String
  /// Provider's immutable product id, from `provider_tour_id`. Never changes
  /// once set — it is the natural key half that makes re-imports idempotent.
  providerTourId         String
  /// Provider-sourced supplier title (backs a NOT NULL column; the validator
  /// quarantines titleless tours upstream, so this is always present here).
  title                  String
  /// Provider-sourced description; null when the payload omits it.
  description            String?
  /// Duration in minutes, or null for variable-duration products.
  durationMin            Int?
  /// Imported aggregate rating (Viator + TripAdvisor), or null when unrated.
  ratingAvg              Float?
  /// Imported aggregate review count, or null when unrated.
  ratingCount            Int?
  /// "From" price in minor units (e.g. cents). Non-null here — the validator
  /// quarantines missing/non-positive prices upstream.
  priceMinor             BigInt?
  /// ISO-4217 currency code, or null when unpriced.
  currency               String?
  /// "From" price converted to the reference currency (USD) in minor units, or
  /// null when unpriced / no FX rate (BRI-XXX). This — not the supplier-currency
  /// `priceMinor` — is what price bands are computed from, so a band is currency-
  /// correct across a multi-currency catalogue. Computed at ingest, never per-request.
  priceReferenceMinor    BigInt?
  /// Reference currency of {@link priceReferenceMinor}; "USD" today.
  priceReferenceCurrency String?     @default("USD")
  /// Provider deep link (affiliate params intact), or null when absent.
  affiliateUrl           String?
  /// Provider's opaque start-location reference, or null.
  locationRef            String?
  /// Resolved latitude (WGS-84), or null when unresolved (BRI-163: a null-geo
  /// tour is legitimately published, not quarantined). BRI-218: the first usable
  /// of itinerary POI → traveler pickup → start → end (see `position.ts`), within
  /// 40 km of the city; not always the start point.
  latitude               Float?
  /// Resolved start longitude (WGS-84), or null when unresolved.
  longitude              Float?
  /// Provider cover-image URL (the `isCover` image's mid-size variant), or null
  /// when the payload carries no imagery. Provider-owned content, surfaced on the
  /// linked Experience's card (ST-11). BRI-164.
  imageUrl               String?
  /// Alt text for {@link imageUrl} (the image caption), or null.
  imageAlt               String?
  /// The product's full image gallery — every image the payload lists, with
  /// captions and every resolution variant, versus the single-cover-image
  /// projection ({@link imageUrl}/{@link imageAlt}) above. Provider-owned
  /// content; `[]` when the payload carries no imagery. Task 1 of the
  /// provider-content-capture series (image gallery / inclusions-exclusions /
  /// cancellation policy / reviews-by-source).
  images                 Json        @default("[]")
  /// Inclusions/exclusions checklist items, verbatim from the payload's
  /// `inclusions`/`exclusions` arrays. Raw `description`/`otherDescription`
  /// (used inconsistently per `type`) are collapsed into one `description`.
  /// Empty array when absent. Task 2 of the provider-content-capture series.
  inclusions             Json        @default("[]")
  exclusions             Json        @default("[]")
  /// Cancellation policy (type, refund-by-cutoff tiers, weather/traveler-
  /// count flags), verbatim from the payload's `cancellationPolicy`
  /// object. `null` when the product carries none — distinct from an
  /// empty tier list.
  cancellationPolicy     Json?
  /// Per-source review breakdown (provider name, total count, average
  /// rating, 5-bucket star histogram), verbatim from `reviews.sources`.
  /// `rating_avg`/`rating_count` above remain the blended scalars used
  /// for display/sort; this is the un-blended detail (e.g. Viator vs.
  /// TripAdvisor volume). Empty array when absent.
  reviewsBySource        Json        @default("[]")
  /// Provider destination refs this product is filed under, e.g. `["343"]`
  /// (Bangkok). Taken verbatim from the payload's `destinations[].ref`. The
  /// import linker matches these against curated `City.viatorDestRef` to decide
  /// which City an imported Experience belongs to (BRI-164). Empty when absent.
  destinationRefs        String[]    @default([])
  /// Provider category tag IDs, verbatim from the product payload's top-level
  /// `tags` array (category Stage A). Opaque numeric IDs; name/category
  /// resolution via `/products/tags` is a deferred follow-up. Empty when absent.
  tags                   Int[]       @default([])
  /// FK to the Atlas Experience this Tour was linked to (BRI-164), or null until
  /// the import linker creates/links one. `SetNull` on delete: a Tour outlives
  /// the unlinking of its Experience rather than being cascaded away.
  experienceId           String?
  experience             Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  /// Provenance: when the raw page was fetched (from the DTO, ST-6 crawl time).
  fetchedAt              DateTime
  /// Provenance: SHA-256 of the normalized content. Lets a re-import detect an
  /// unchanged row without a field-by-field compare.
  sourceHash             String
  /// When this row was first written.
  createdAt              DateTime    @default(now())
  /// When this row was last upserted.
  updatedAt              DateTime    @updatedAt
  /// Soft-delete tombstone: non-null once the tour vanished from a later run.
  /// Read paths filter on `deletedAt: null`; cleared again if the tour returns.
  deletedAt              DateTime?
  /// Generated AI copy for this tour (BRI-154), or null until a generation run
  /// creates one. The importer never reads or writes this relation — re-import
  /// leaves an existing row in place (AC-16).
  tourCopy               TourCopy?

  /// The immutable natural key. Makes upserts idempotent and gives the
  /// soft-delete diff a stable identity to match rows on.
  @@unique([provider, providerTourId])
  /// Active-catalogue reads and the run diff both scope by provider + liveness.
  @@index([provider, deletedAt])
  /// The linker selects active, unlinked tours; the read path joins by Experience.
  @@index([experienceId])
}

/// A normalized tour that failed validation and was quarantined instead of
/// published (ST-8 / BRI-105). The full payload is retained verbatim (`payload`)
/// alongside the reason(s) it failed, so the row is reviewable later — Admin
/// surfacing is a future story. Rows here never reach the public site.
model QuarantinedTour {
  id             String   @id @default(cuid())
  /// Source OTA, from the payload's `provider`. Always "viator" today.
  provider       String
  /// Provider product id, from the payload's `provider_tour_id`.
  providerTourId String
  /// Content hash from the payload's `source_hash` (dedupes repeat quarantines).
  sourceHash     String
  /// Machine-readable reason codes, e.g. ["MISSING_TITLE","NON_POSITIVE_PRICE"].
  reasonCodes    String[]
  /// The reasons in full (code + human message), as captured at validation time.
  reasons        Json
  /// The complete TourDTO payload, retained verbatim for review.
  payload        Json
  /// When the row was quarantined.
  quarantinedAt  DateTime @default(now())

  @@index([provider, providerTourId])
}

/// Terminal state of a single import run (ST-10 / BRI-107).
///
/// `aborted` is deliberately distinct from `failed`: it is the specific outcome
/// of ST-9's mass-deletion guard tripping (a `MassDeletionAbortError`), where the
/// run rolled back *on purpose* to protect the catalogue — not an unexpected
/// crash. Keeping them separate lets an operator tell "the safety guard did its
/// job" apart from "something broke".
enum ImportRunStatus {
  /// The run is in flight (row created, pipeline not yet finished).
  running
  /// The pipeline completed and the upsert transaction committed.
  succeeded
  /// The pipeline threw an unexpected error; nothing partial is left running.
  failed
  /// ST-9's mass-deletion guard tripped; the upsert rolled back by design.
  aborted
}

/// One execution of the ingest pipeline (ST-10 / BRI-107).
///
/// A row is written the moment a run starts (status `running`) and updated in
/// place with the final status, counts, and `finishedAt` when it ends — whether
/// it succeeds, fails, or is aborted by the mass-deletion guard. It is the
/// durable audit trail for both the nightly scheduled crawl and any manual
/// trigger: every run leaves exactly one record, so a run is never silently
/// missing and never stuck as `running`.
///
/// The counts mirror what each pipeline stage already reports — `fetched` from
/// the ST-6 client, `normalized` from the ST-7 normalizer, `quarantined` from
/// the ST-8 validator, `upserted`/`softDeleted` from the ST-9 upsert — rather
/// than being recomputed here. On an aborted run the upsert commits nothing, so
/// `upserted`/`softDeleted` stay 0 while the earlier stages' counts are retained.
model ImportRun {
  id            String          @id @default(cuid())
  /// Source OTA this run crawled. Always "viator" today.
  provider      String          @default("viator")
  /// How the run was kicked off: "scheduled" (nightly cron) or "manual" (CLI).
  trigger       String
  /// Terminal state; starts `running`, updated once on completion.
  status        ImportRunStatus @default(running)
  /// Raw products pulled from the provider (ST-6).
  fetched       Int             @default(0)
  /// Products that normalized to a TourDTO without error (ST-7).
  normalized    Int             @default(0)
  /// Tours the validator quarantined instead of publishing (ST-8).
  quarantined   Int             @default(0)
  /// Rows inserted or updated in the live catalogue (ST-9).
  upserted      Int             @default(0)
  /// Rows soft-deleted this run (active before, absent now) (ST-9).
  softDeleted   Int             @default(0)
  /// Last pagination cursor observed. Null on a clean finish; otherwise the
  /// resume point for this run's next segment (BRI-176: a run now spans one
  /// or more segment-worker child processes — see ImportRunService's
  /// docstring). Was write-only before BRI-176 (M1 was fully synchronous, one
  /// process, no resume); now it's the actual handoff between segments.
  cursor        String?
  /// Last global page number this run reached, across every segment so far
  /// (BRI-176). Threaded into the next segment's `startPage` so R2 archive
  /// keys (`raw/{source}/{date}/{page}.json`) stay unique across the whole
  /// run instead of each segment restarting page numbering at 1 and
  /// overwriting an earlier segment's archives. Null until the first segment
  /// completes at least one page.
  lastPage      Int?
  /// Last non-null pagination cursor this run ever observed, across every
  /// segment (BRI-181) — unlike `cursor` (nulled on a clean finish, the
  /// signal segment-worker uses to know the crawl is fully done), this is
  /// never reset back to null once set. Per Viator's documented ongoing-
  /// refresh contract, the value to resume a *future* run's delta crawl
  /// from is the cursor that fetched the crawl's final page — exactly the
  /// last non-null cursor a segment ever saw — so this is what
  /// ImportRunService.execute() reads back in to seed a new run's `cursor`
  /// at creation. Null until the first segment of the run observes a page
  /// with a `nextCursor`.
  lastCursor    String?
  /// Immutable snapshot of `cursor`'s value at this run's creation (BRI-184)
  /// -- unlike `cursor` (overwritten by every segment as pagination advances)
  /// and `lastCursor` (updated whenever any segment sees a new cursor, to
  /// seed the *next* run), this field is written once by
  /// ImportRunService.execute() and never touched again. Null means this run
  /// started as an attempted full crawl (no prior resume point was found, or
  /// an explicit modifiedSince override forced one); non-null means this run
  /// resumed a delta crawl from that cursor. segment-worker.cli.ts reads this
  /// -- not the mutable `cursor` field, which is null again on any clean
  /// finish regardless of how the run started -- to decide whether it's safe
  /// to attempt the guarded soft-delete reconciliation at all: a delta run
  /// only ever sees a slice of the catalogue by design, so it must never
  /// attempt that step, guard threshold or not.
  cursorAtStart String?
  /// Human-readable failure/abort message, when status is `failed` or `aborted`.
  error         String?
  /// When the run started (row created).
  startedAt     DateTime        @default(now())
  /// When the run reached a terminal state; null while `running`.
  finishedAt    DateTime?

  /// Recent-runs listing scopes by provider, newest first.
  @@index([provider, startedAt])
}

/// Cache of provider location references resolved to coordinates
/// (ST-7b / BRI-163). Viator's product payload carries only an opaque location
/// reference (`logistics.start[].location.ref`) — never coordinates — so we
/// resolve each reference once via `/locations/bulk` and persist the result
/// here. The cache survives across import runs: a reference resolved on a
/// previous crawl is a hit today, so it is never re-fetched. Location data
/// changes infrequently (Viator's guidance: refresh monthly), so rows carry no
/// short-lived invalidation.
model ProviderLocation {
  /// Provider location reference, e.g. "LOC-abc123". Natural primary key.
  reference  String   @id
  /// Source OTA. Always "viator" today; kept explicit for future providers.
  provider   String   @default("viator")
  /// Resolved latitude (WGS-84 decimal degrees), from `center.latitude`.
  latitude   Float
  /// Resolved longitude (WGS-84 decimal degrees), from `center.longitude`.
  longitude  Float
  /// Location display name, when the provider supplies one.
  name       String?
  /// When this reference was last resolved (refreshed on re-resolve).
  resolvedAt DateTime @default(now()) @updatedAt
}

/// Cached Viator FX rate (category/currency promotion plan, Task 2).
/// `/availability/schedules` returns `fromPrice` in the *supplier's* currency,
/// which varies per product and cannot be pinned, so Atlas converts to a single
/// reference currency (`PRICE_REFERENCE_CURRENCY`, USD today) via Viator's
/// `/exchange-rates` endpoint. Rates carry an `expiry` (Viator updates daily
/// today, "may change"): a row is refreshed only once `now > expiresAt`, never
/// on a fixed interval. Keyed on the currency pair.
model ProviderExchangeRate {
  /// Source OTA. Always "viator" today; kept explicit for future providers.
  provider       String   @default("viator")
  /// ISO-4217 source currency (the supplier's), e.g. "THB".
  sourceCurrency String
  /// ISO-4217 target currency; always the reference currency ("USD") today.
  targetCurrency String
  /// Multiply a source-currency major amount by this to get a target-currency
  /// major amount.
  rate           Float
  /// Viator's `lastUpdated` for this rate (UTC).
  lastUpdatedAt  DateTime
  /// Viator's `expiry` (UTC): the rate is valid until this instant. The refresh
  /// trigger — a row with `expiresAt <= now` is re-fetched before use.
  expiresAt      DateTime
  /// When Atlas last wrote this row.
  fetchedAt      DateTime @default(now()) @updatedAt

  @@id([provider, sourceCurrency, targetCurrency])
}

/// First-party affiliate click log (ST-24 / BRI-136). Append-only: one row is
/// written by `GET /go/:tourId` **before** it 302s to the provider deep link, so
/// no click is lost even though Viator attributes commission via the `productUrl`
/// itself (docs/06). Never updated or deleted. Mirrors docs/02 §7 `affiliate_clicks`.
///
/// `tourId` is a **text identifier, not an FK** — during the static→DB transition
/// a click can reference either a hand-authored experience (the
/// `"<citySlug>/<experienceId>"` key from `viator-links.json`) or, later, a DB
/// `Tour.id`. Keeping it a plain string lets both coexist without a nullable FK.
/// PII is minimised: the IP is stored only as a salted hash, never raw.
model AffiliateClick {
  /// Surrogate key. High-volume append-only table, so a bigint identity.
  id         BigInt   @id @default(autoincrement())
  /// The clicked tour's identifier (static "<slug>/<expId>" key or DB Tour.id).
  tourId     String
  /// Source OTA the deep link points at. Always "viator" today.
  providerId String
  /// Opaque first-party session id, when the caller has one; null otherwise.
  sessionId  String?
  /// Referring URL (the page the CTA was clicked from), when sent.
  referrer   String?
  /// Requesting user agent, when sent.
  userAgent  String?
  /// Salted SHA-256 of the client IP — never the raw IP. Null when unavailable.
  ipHash     String?
  /// When the click was logged (row created). The only time this row is touched.
  createdAt  DateTime @default(now())

  /// Analytics reads scan by time window (docs/02 §7 `affiliate_clicks_created_idx`).
  @@index([createdAt])
  /// Search ranking's popularity term (ST-13 / BRI-125) counts clicks per tour.
  @@index([tourId])
}

/// Terminal state of one `TourCopy` row (BRI-154). There is no `pending`
/// state: a row is written only once generation finishes, either passing the
/// deterministic check (`published`) or exhausting its one corrective retry
/// (`failed`). A tour with no row yet was never generated at all.
enum TourCopyStatus {
  /// The paragraph passed the deterministic check and `aiSummary` is served
  /// by the read path when its grounding hash and eligibility still hold.
  published
  /// Both attempts failed the check, or the model refused. `aiSummary` is
  /// null; provider text keeps being served for the tour.
  failed
  /// A `published` row pulled by the kill switch or by hand (BRI-201, spec
  /// 0003). `aiSummary` is kept, never cleared; the read path serves null for
  /// it, and `tour-copy:run` skips it at the pair (promptVersion, model) that
  /// was withdrawn.
  withdrawn
}

/// Who produced one `TourCopyEval` verdict (BRI-201, spec 0003).
enum TourCopyEvaluator {
  judge
  human
}

/// Worst claim on a judged page (BRI-201, spec 0003). A human `g` is `clean`.
enum TourCopyClaimVerdict {
  clean
  unsupported
  contradicted
}

/// AI-generated tour copy (BRI-154, spec 0002), one row per `Tour`. Written
/// only by `tour-copy.cli.ts` / `TourCopyService` — the importer and
/// `TourUpsertService` never read or write this table (AC-16). The read path
/// (`DestinationService`) serves `aiSummary` only when this row is
/// `published`, `groundingHash` matches a hash recomputed from the tour's
/// current fields, and the tour is still eligible (AC-12); it never mutates
/// this table.
model TourCopy {
  id               String         @id @default(cuid())
  /// The tour this copy was generated for. Unique: one row per tour, never
  /// more (AC-4). Cascades on tour deletion — copy has no meaning without it.
  tourId           String         @unique
  tour             Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  status           TourCopyStatus
  /// The generated paragraph. Null when `failed`; a non-empty, check-passed
  /// string when `published` (AC-4, key invariant).
  aiSummary        String?
  /// `v1:` plus a sha256 hex digest of the five grounding fields (title,
  /// description, durationMin, inclusions, exclusions). The read path
  /// recomputes this from the tour's current fields and serves `aiSummary`
  /// only on a match (AC-3, AC-12).
  groundingHash    String
  /// The model id that produced this row (e.g. "claude-sonnet-5"), from
  /// `TOUR_COPY_MODEL` at generation time.
  model            String
  /// `TOUR_COPY_PROMPT_VERSION` at generation time. A later run regenerates a
  /// `published` row only when `--regenerate-older-than-version N` names a
  /// version above this one (AC-7).
  promptVersion    Int
  /// When this row's generation attempt(s) completed.
  generatedAt      DateTime
  /// 1 (first attempt passed, or the model refused) or 2 (one corrective
  /// retry was made).
  attempts         Int
  /// Reason codes from the closed set in AC-5, plus `refusal` and
  /// `source_too_thin`. Empty when the first attempt passed.
  failureReasons   String[]       @default([])
  /// The run that wrote this row, also sent to the gateway as the `run_id`
  /// request metadata — the durable link between a row and its gateway logs.
  runId            String
  /// Set when the kill switch or a manual withdraw moves the row to
  /// `withdrawn` (BRI-201); null again when the row is restored or regenerated.
  withdrawnAt      DateTime?
  /// The eval run id (kill switch) or the `randomUUID` a manual withdraw
  /// generated. Null whenever `withdrawnAt` is.
  withdrawnByRunId String?
  /// `{emDash, contrastiveReveal, clicheOrIntensifier}` counted on the
  /// published paragraph (spec 0003 AC-4). Null on rows made before it existed.
  voiceCounts      Json?
  /// `duration` or `other`, from the paragraph's first sentence (AC-4).
  openingPattern   String?
  evals            TourCopyEval[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// One judgment of one paragraph (BRI-201, spec 0003), by the judge model or a
/// human. Shared by both so agreement is a query. Tied to the exact text judged
/// (`copyGeneratedAt`) and the rubric version used, so a regenerated paragraph
/// or a changed rubric never inherits an old verdict.
model TourCopyEval {
  id              String               @id @default(cuid())
  tourCopyId      String
  tourCopy        TourCopy             @relation(fields: [tourCopyId], references: [id], onDelete: Cascade)
  /// The `generatedAt` of the copy judged.
  copyGeneratedAt DateTime
  /// The paragraph judged, kept so the verdict survives regeneration.
  judgedText      String
  /// Copied from the `TourCopy` row when judged.
  promptVersion   Int
  model           String
  groundingHash   String
  evaluator       TourCopyEvaluator
  /// The judge model id; null for a human.
  evaluatorModel  String?
  /// Bumped whenever the rubric text changes. Human rows carry the current
  /// registry version for `tour_copy`.
  rubricVersion   Int
  /// `[{text, verdict, evidenceQuote, downgraded?}]`. A human `b` stores one
  /// entry holding the note, a human `g` stores `[]`.
  claims          Json
  claimVerdict    TourCopyClaimVerdict
  /// Rubric 2b: does the paragraph open on one specific, checkable fact.
  leadsWithFact   Boolean
  /// Groups one CLI run.
  evalRunId       String
  createdAt       DateTime             @default(now())

  @@unique([tourCopyId, copyGeneratedAt, evaluator, rubricVersion])
  @@index([promptVersion, model])
}
