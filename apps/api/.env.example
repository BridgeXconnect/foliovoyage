# Port the NestJS API listens on. Optional — defaults to 3001 when unset.
# The web app (apps/web) runs on 3000, so keep these distinct in local dev.
PORT=3001

# Backing services (ST-2 / BRI-97). Required — the API validates these on boot
# (zod) and fails fast if missing or malformed. Defaults below match the local
# Docker Compose stack in infra/docker-compose.yml.
#
# Postgres (PostGIS + pg_trgm). postgres:// or postgresql:// scheme.
DATABASE_URL=postgres://folio:folio@localhost:5432/folio

# Redis. redis:// (or rediss:// for TLS).
REDIS_URL=redis://localhost:6379

# --- Ingest / Viator OTA client (ST-6 / BRI-103) ----------------------------
# Viator Partner API key. Secret — sent as the `exp-api-key` header. Get this
# from the Viator partner portal; never commit the real value.
VIATOR_API_KEY=your-viator-partner-api-key

# Viator API base URL. Production default shown; sandbox is
# https://api.sandbox.viator.com/partner. The host here is the ONLY host the
# outbound fetcher is permitted to reach (SSRF allowlist). Optional.
VIATOR_API_BASE_URL=https://api.viator.com/partner

# Accept-Language sent to Viator. Optional — defaults to en-US.
VIATOR_API_LANGUAGE=en-US

# --- Raw-payload archive: Cloudflare R2 (S3-compatible) ---------------------
# Every fetched page is archived to R2 at raw/viator/{date}/{page}.json before
# processing — the replay safety net. Credentials are secret; supply via env.
#
# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=folio-voyage-raw
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# --- Ingest / mass-deletion abort guard (ST-9 / BRI-106) --------------------
# If a single import run would soft-delete MORE THAN this percentage (0–100) of
# a provider's currently active catalogue, the whole run aborts and commits
# nothing — a truncated upstream response must never wipe the catalogue.
# Optional — defaults to 10.
DELETE_GUARD_THRESHOLD_PCT=10

# --- Ingest / nightly scheduler (ST-10 / BRI-107) ---------------------------
# Cron expression for the nightly import (standard 5-field crontab syntax).
# Optional — defaults to 03:00 daily.
IMPORT_CRON_SCHEDULE=0 3 * * *

# Whether the nightly scheduled import is registered at boot. Set false in local
# dev / CI so a background crawl never fires unexpectedly; a manual trigger
# (pnpm --filter @folio/api import:run) still works either way. Accepts
# true/false/1/0. Optional — defaults to true.
IMPORT_CRON_ENABLED=true
