# Port the NestJS API listens on. Optional — defaults to 3001 when unset.
# The web app (apps/web) runs on 3000, so keep these distinct in local dev.
PORT=3001

# Backing services (ST-2 / BRI-97). Required — the API validates these on boot
# (zod) and fails fast if missing or malformed. Defaults below match the local
# Docker Compose stack in infra/docker-compose.yml.
#
# Postgres (PostGIS + pg_trgm). postgres:// or postgresql:// scheme.
DATABASE_URL=postgres://folio:folio@localhost:5432/folio

# Redis. redis:// (or rediss:// for TLS).
REDIS_URL=redis://localhost:6379

# --- Ingest / Viator OTA client (ST-6 / BRI-103) ----------------------------
# Viator Partner API key. Secret — sent as the `exp-api-key` header. Get this
# from the Viator partner portal; never commit the real value.
VIATOR_API_KEY=your-viator-partner-api-key

# Viator API base URL. Production default shown; sandbox is
# https://api.sandbox.viator.com/partner. The host here is the ONLY host the
# outbound fetcher is permitted to reach (SSRF allowlist). Optional.
VIATOR_API_BASE_URL=https://api.viator.com/partner

# Accept-Language sent to Viator. Optional — defaults to en-US.
VIATOR_API_LANGUAGE=en-US

# Request timeout (ms) for every outbound Viator call. Optional — defaults to
# 60000 (60s), chosen empirically from a real full-catalog crawl (BRI-171) —
# a shorter 30s default proved too tight in practice. A thrown timeout is
# retried the same as a 5xx, so this mainly bounds a genuinely stuck
# connection rather than the high end of normal latency.
VIATOR_REQUEST_TIMEOUT_MS=60000

# --- Raw-payload archive: Cloudflare R2 (S3-compatible) ---------------------
# Every fetched page is archived to R2 at raw/viator/{date}/{page}.json before
# processing — the replay safety net. Credentials are secret; supply via env.
#
# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=folio-voyage-raw
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# --- Ingest / mass-deletion abort guard (ST-9 / BRI-106) --------------------
# If a single import run would soft-delete MORE THAN this percentage (0–100) of
# a provider's currently active catalogue, the whole run aborts and commits
# nothing — a truncated upstream response must never wipe the catalogue.
# Optional — defaults to 10.
DELETE_GUARD_THRESHOLD_PCT=10

# --- Ingest / nightly scheduler (ST-10 / BRI-107) ---------------------------
# Cron expression for the nightly import (standard 5-field crontab syntax).
# Optional — defaults to 03:00 daily.
IMPORT_CRON_SCHEDULE=0 3 * * *

# Whether the nightly scheduled import is registered at boot. Set false in local
# dev / CI so a background crawl never fires unexpectedly; a manual trigger
# (pnpm --filter @folio/api import:run) still works either way. Accepts
# true/false/1/0. Optional — defaults to true.
IMPORT_CRON_ENABLED=true

# Minutes a run may sit in status "running" before a startup safeguard reaps
# it as "failed" — protects against a process that crashed/OOM'd mid-run and
# never got to finalize its own row (BRI-170). Checked once at every boot.
# Optional — defaults to 120.
IMPORT_STUCK_RUN_TIMEOUT_MINUTES=120

# --- Affiliate click log (ST-24 / BRI-136) ----------------------------------

# Shared secret guarding POST /v1/affiliate-clicks. The web /go route handler
# sends it as x-internal-secret; the API rejects mismatches, so only the web
# server can write click rows. The web app must set the SAME value
# (apps/web INTERNAL_CLICK_SECRET). Optional locally (a dev default is used);
# OVERRIDE with a strong secret in every real environment.
INTERNAL_CLICK_SECRET=dev-internal-click-secret

# Salt mixed into the SHA-256 of a click's client IP before storage, so ip_hash
# never derives back to a raw IP. Optional locally; OVERRIDE in real environments.
IP_HASH_SALT=dev-ip-hash-salt

# --- Nightly import / external wake trigger (BRI-173) -----------------------

# Shared secret guarding POST /v1/import/trigger. Render's free-tier web
# service sleeps after 15 minutes idle, so the in-process nightly cron
# (ImportScheduler) can't fire while asleep — a scheduled GitHub Actions
# workflow calls this endpoint at the same cron time to wake the instance and
# start the run instead. Sent as x-import-trigger-secret; must match the
# workflow's IMPORT_TRIGGER_SECRET repo secret. Optional locally (a dev
# default is used); OVERRIDE with a strong secret in every real environment.
IMPORT_TRIGGER_SECRET=dev-import-trigger-secret

# The service's own public URL, e.g. https://atlas-api.onrender.com. Render
# auto-injects this for every web service — do NOT set it by hand (leave
# unset locally). Used only to build the self-heartbeat ping URL during an
# import run (BRI-173): Render's idle timer resets on inbound traffic only,
# so a multi-hour run must keep pinging its own /health endpoint from outside
# or the platform can suspend it mid-crawl. Absent locally, where there's no
# spin-down to guard against — the heartbeat simply no-ops.
# RENDER_EXTERNAL_URL=https://atlas-api.onrender.com
