# Base URL of the Folio Voyage API (NestJS). SERVER-SIDE ONLY — read by server
# components at request time to fetch destination data (ST-5 / BRI-100). Not
# prefixed NEXT_PUBLIC_, so it never reaches the browser. Defaults to the local
# API port (3001) when unset.
API_BASE_URL=http://localhost:3001

# Canonical site origin, used for metadata, canonical URLs, sitemap, and robots.
# Set this in Vercel (Project Settings → Environment Variables) to your real domain.
# Falls back to http://localhost:3000 in development when unset.
NEXT_PUBLIC_SITE_URL=https://foliovoyage.com

# Viator Partner API key (Basic Access affiliate tier).
# SERVER-SIDE ONLY — never prefixed NEXT_PUBLIC_, never sent to the browser.
# Used exclusively by scripts/fetch-viator-links.mjs at build/enrichment time to
# resolve destination IDs and match products; it is NOT read at request time.
# Get it from: Viator partner dashboard → Tools → Affiliate API → Start your
# development. Put the real value in a gitignored .env.local (see docs/07).
VIATOR_API_KEY=your-viator-partner-api-key

# PostHog project token for product analytics (posthog-js).
# NEXT_PUBLIC_ — inlined into the browser bundle at BUILD time (public by
# design; safe to expose). Set it in Vercel (Project Settings → Environment
# Variables) for Production/Preview/Development, then trigger a fresh build —
# NEXT_PUBLIC_ vars are baked in at build, so a cache-only redeploy won't pick
# up a new value. Analytics send nothing until this is set. The data endpoint is
# routed through the /ingest reverse proxy (next.config.ts) and the PostHog UI
# host is hardcoded in instrumentation-client.ts, so no host var is needed.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-token

# Shared secret for the first-party affiliate click log (ST-24 / BRI-136).
# SERVER-SIDE ONLY — the /go route handler sends it to the API's
# POST /v1/affiliate-clicks as x-internal-secret. Must MATCH the API's
# INTERNAL_CLICK_SECRET. Optional locally (a dev default is used); OVERRIDE with
# a strong secret in every real environment.
INTERNAL_CLICK_SECRET=dev-internal-click-secret

# Pre-launch "coming soon" gate password (src/lib/site-gate.ts). SERVER-SIDE
# ONLY. The gate is ON whenever this is set to a non-empty value, OFF (site
# fully public) when absent — so launching is just deleting the var in Vercel,
# no redeploy of new logic needed. Optional — unset locally by default.
SITE_GATE_PASSWORD=
