# Folio Voyage — API environment (ST-2 / BRI-97).
# Copy to .env and adjust as needed. These values match the defaults in
# infra/docker-compose.yml, so with the local stack up they work as-is.
#
# NO REAL SECRETS in this file — it is committed as a template.

# Postgres connection string (PostGIS + pg_trgm enabled on first init).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://folio:folio@localhost:5433/folio

# Redis connection string.
# Format: redis://<host>:<port>  (or rediss:// for TLS)
REDIS_URL=redis://localhost:6379
