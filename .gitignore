# OS / editor cruft
.DS_Store
*.swp

# Env files (never commit secrets). *.env.example templates are intentionally tracked.
.env
.env.*
!.env.example
!**/.env.example

# Safety net — apps have their own .gitignore, but guard build artifacts here too.
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
*.tsbuildinfo
.vercel

# Turborepo local cache / logs
.turbo/
**/.turbo/
