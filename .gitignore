# OS / editor cruft
.DS_Store
*.swp

# Env files (never commit secrets). apps/web/.env.example is intentionally tracked.
.env
.env.*
!apps/web/.env.example

# Safety net — apps have their own .gitignore, but guard build artifacts here too.
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
*.tsbuildinfo
.vercel

# Turborepo local cache / logs
.turbo/
**/.turbo/
