# Optional overrides for the local Docker Compose stack (infra/docker-compose.yml).
# Copy to infra/.env to change credentials or host ports. Every value has a
# built-in default, so `docker compose up` works without this file.
#
# These are LOCAL DEV ONLY credentials — never a source of real secrets.

# Postgres database/user/password created on first init.
POSTGRES_DB=folio
POSTGRES_USER=folio
POSTGRES_PASSWORD=folio

# Host ports the services are published on.
POSTGRES_PORT=5433
REDIS_PORT=6379
